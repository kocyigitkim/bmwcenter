    "dtc.guidance.fuelAir.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code points to a serious fault in engine management, fuel, or air intake. It can cause power loss, excess fuel use, or engine damage. Avoid pushing the engine hard and get it checked at a service center as soon as possible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod motor yönetimi, yakıt veya hava besleme sisteminde ciddi bir arızaya işaret ediyor. Performans kaybı, aşırı yakıt tüketimi veya motor hasarı riski olabilir. Motoru zorlamadan en kısa sürede bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.fuelAir.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code points to a fault in engine management, fuel, or air intake. Driving can continue, but fuel economy or emissions may be affected. Have it checked at a service center soon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod motor yönetimi, yakıt veya hava besleme sisteminde bir arızaya işaret ediyor. Sürüşe devam edilebilir ancak yakıt tüketimi veya emisyon değerleri etkilenebilir. Yakın zamanda bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.fuelAir.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a minor deviation in engine management with no urgent risk. Mention it at your next scheduled service."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod motor yönetiminde küçük bir sapmayı gösteriyor, acil bir risk taşımıyor. Bir sonraki periyodik bakımda servise bildirmeniz yeterli."
          }
        }
      }
    },
    "dtc.guidance.chassis.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code points to a serious fault in brakes, suspension, steering, or wheel-speed systems — it can directly affect driving safety. Have it checked before continuing to drive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod fren, süspansiyon, direksiyon veya teker hızı sistemlerinde ciddi bir arızaya işaret ediyor — sürüş güvenliğini doğrudan etkileyebilir. Aracı kullanmadan önce mutlaka bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.chassis.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a deviation in brakes, suspension, or steering. Drive carefully and have it checked at a service center soon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod fren, süspansiyon veya direksiyon sisteminde bir sapmayı gösteriyor. Dikkatli sürün ve yakın zamanda bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.chassis.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a minor chassis-system deviation with no urgent risk. Mention it at your next service."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod şasi sistemlerinde küçük bir sapmayı gösteriyor, acil bir risk taşımıyor. Bir sonraki bakımda bildirin."
          }
        }
      }
    },
    "dtc.guidance.body.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code points to a serious fault in airbags, seat belts, or other occupant-safety systems — they may not work correctly in a crash. Get it checked at an authorized service center as soon as possible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod hava yastığı, emniyet kemeri veya diğer yolcu güvenlik sistemlerinde ciddi bir arızaya işaret ediyor. Bu sistemler bir kaza anında doğru çalışmayabilir — en kısa sürede yetkili servise başvurun."
          }
        }
      }
    },
    "dtc.guidance.body.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a fault in a body/comfort system such as doors, seats, or climate control. It usually doesn't affect driving safety, but have it checked soon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod kapı, koltuk veya klima gibi kaporta/konfor sistemlerinden birinde bir arızayı gösteriyor. Sürüş güvenliğini genelde etkilemez ama yakın zamanda kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.body.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a minor body/comfort-system deviation with no urgent risk. Mention it at your next service."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod kaporta/konfor sistemlerinde küçük bir sapmayı gösteriyor, acil bir risk taşımıyor. Bir sonraki bakımda bildirin."
          }
        }
      }
    },
    "dtc.guidance.network.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a serious communication breakdown between the vehicle's control modules (CAN bus). It can cause other systems to also misbehave — get it checked as soon as possible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod araç içi kontrol modülleri arasındaki iletişimde (CAN veri yolu) ciddi bir kopukluğu gösteriyor. Bu durum başka sistemlerin de yanlış çalışmasına yol açabilir — en kısa sürede servise başvurun."
          }
        }
      }
    },
    "dtc.guidance.network.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows an intermittent communication issue with a control module. Have it checked at a service center soon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod bir kontrol modülüyle iletişimde aralıklı bir sorunu gösteriyor. Yakın zamanda bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.network.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code shows a minor, intermittent communication deviation with no urgent risk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod iletişim sisteminde küçük, aralıklı bir sapmayı gösteriyor, acil bir risk taşımıyor."
          }
        }
      }
    },
    "dtc.guidance.other.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is classified as a serious fault. Avoid pushing the vehicle hard and get it checked at a service center as soon as possible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod ciddi olarak sınıflandırılmış bir arızayı gösteriyor. Aracı zorlamadan en kısa sürede bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.other.medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is a moderate fault. Have it checked at a service center soon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod orta düzeyde bir arızayı gösteriyor. Yakın zamanda bir servise kontrol ettirin."
          }
        }
      }
    },
    "dtc.guidance.other.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code is a low-priority deviation with no urgent risk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod düşük öncelikli bir sapmayı gösteriyor, acil bir risk taşımıyor."
          }
        }
      }
    },
    "dtc.guidance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should you do?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne yapmalısınız?"
          }
        }
      }
    },
    "dashboard.edit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
